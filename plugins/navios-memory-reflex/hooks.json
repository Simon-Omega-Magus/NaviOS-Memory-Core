{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/navios-memory-hook",
            "statusMessage": "Restoring durable NaviOS memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/navios-memory-hook",
            "statusMessage": "Retrieving relevant project memory"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/navios-memory-hook",
            "statusMessage": "Freezing the authoritative checkpoint"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/navios-memory-hook",
            "statusMessage": "Arming compaction recovery"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/navios-memory-hook",
            "statusMessage": "Checking compaction recovery state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/navios-memory-hook"
          }
        ]
      }
    ]
  }
}
